 "end": 43.0,
 "phrases": [
  "רובוט דמוי אדם אחד עולה כמו אופנוע.",
  "השני,",
  "כמו מכונית...",
  "ורק אחד מהם נבנה לעבוד אצלכם בבית.",
  "אז על מה בעצם משלמים?",
  "מאחורי כל מפרק של רובוט יש מנוע,",
  "תמסורת וחיישן.",
  "ולרובוט דמוי אדם,",
  "יש עשרות מפרקים.",
  "הזול בגובה של ילד.",
  "הוא בנוי למפתחים,",
  "לפעלולים ולהדגמות.",
  "היקר בגובה של אדם,",
  "עטוף בגוף רך.",
  "ובכל יד שלו,",
  "יותר מעשרים מפרקים,",
  "כדי לתפוס כוס בלי לשבור אותה.",
  "אבל הנה החלק המטורף:",
  "את היקר,",
  "כבר אפשר להזמין מראש,",
  "גם במנוי חודשי,",
  "כמו ליסינג!",
  "עוד הסברים כאלה?",
  "תעקבו.",
  "בינתיים בעיקר בארצות הברית.",
  "ורוב התחזיות אומרות, שהמחיר ירד.",
  "הייתם לוקחים רובוט במנוי?",
  "כן",
  "או לא."
 ],
 "speed": 1.15
