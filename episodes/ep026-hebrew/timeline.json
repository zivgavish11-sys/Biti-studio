  "אבל מילים זה לא מספיק.",
  "תעיף,",
  "זה גם לזרוק,",
  "וגם להעיף באוויר.",
  "אז המוח שלו בודק את ההקשר.",
  "מה המצלמות רואות,",
  "מה אמרתם קודם,",
  "ומה אנשים בדרך כלל מתכוונים.",
  "את זה הוא למד מהמון טקסט,",
  "שבני אדם כתבו.",
  "אבל הנה החלק המטורף:",
  "על עברית,",
  "הוא קרא הרבה פחות מאשר על אנגלית.",
  "וסלנג?",
  "עוד פחות!",
  "אז רובוט טוב,",
  "כשהוא לא בטוח,",
  "צריך לעשות דבר פשוט.",
  "לשאול אתכם,",
  "לזרוק לפח?",
  "עוד הסברים על רובוטים?",
  "תעקבו."
 ],
