 "end": 35.32,
 "phrases": [
  "אם המחשב של הרחפן מפסיק לעבוד,",
  "הוא נופל כמו אבן!",
  "אני ביטי,",
  "והיום אני אלמד אתכם,",
  "איך רחפן נשאר יציב באוויר.",
  "יש לו ארבעה מנועים,",
  "ובתוכו חיישן קטן,",
  "שמרגיש כל הטיה.",
  "רוח דוחפת אותו?",
  "החיישן מרגיש,",
  "והמחשב מגביר מנוע אחד,",
  "ומחליש אחר.",
  "אבל הנה החלק המטורף:",
  "הוא עושה את התיקון הזה מאות פעמים בכל שנייה!",
  "מה שנראה לכם כמו ריחוף רגוע,",
  "זה בעצם מאבק בלי הפסקה.",
  "קצת כמו מלצר,",
  "עם מגש מלא,",
  "בחתונה.",
  "אז רחפן לא באמת עומד במקום.",
  "הוא פשוט מתקן,",
  "מהר יותר ממה שהעין רואה.",
  "תעקבו אחריי,",
  "לעוד תוכן וחדשות על רובוטים."
 ],
 "speed": 1.25
