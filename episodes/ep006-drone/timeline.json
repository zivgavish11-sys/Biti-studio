 "end": 30.05,
 "phrases": [
  "רחפן לא יודע לרחף לבד.",
  "אז איך הוא לא נופל?",
  "יש לו ארבעה מנועים,",
  "ובתוכו חיישן קטן,",
  "שמרגיש כל הטיה.",
  "רוח דוחפת אותו?",
  "החיישן מרגיש,",
  "והמחשב מגביר מנוע אחד,",
  "ומחליש אחר.",
  "אבל הנה החלק המטורף:",
  "הוא עושה את התיקון הזה מאות פעמים בכל שנייה!",
  "מה שנראה לכם כמו ריחוף רגוע,",
  "זה בעצם מאבק בלי הפסקה.",
  "קצת כמו מלצר,",
  "עם מגש מלא,",
  "בחתונה.",
  "אז רחפן לא באמת עומד במקום.",
  "הוא פשוט מתקן,",
  "מהר יותר ממה שהעין רואה.",
  "תעקבו אחריי,",
  "לעוד תוכן וחדשות על רובוטים."
 ],
