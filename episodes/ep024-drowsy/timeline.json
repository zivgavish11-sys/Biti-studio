 "end": 42.6,
 "phrases": [
  "האוטו שלכם יכול לדעת שאתם עייפים...",
  "לפני שאתם שמים לב.",
  "אז איך הוא יודע?",
  "בתוך עמוד ההגה יש חיישן קטן,",
  "שמודד כל הזמן את הזווית של ההגה.",
  "גם כשאתם נוסעים ישר,",
  "הידיים שלכם מתקנות אותו כל הזמן,",
  "בלי שאתם מרגישים.",
  "בדקות הראשונות של הנסיעה,",
  "המחשב של האוטו לומד איך אתם נוהגים כשאתם ערניים.",
  "אבל הנה החלק המטורף:",
  "כשאתם מתחילים להירדם,",
  "הידיים כמעט מפסיקות לזוז.",
  "רגע ארוך כמעט בלי תיקונים,",
  "ואז פתאום,",
  "משיכה חדה בהגה!",
  "המערכת הזאת לא צריכה לראות אתכם,",
  "היא מרגישה אתכם דרך ההגה.",
  "המחשב משווה את זה לנהיגה הרגילה שלכם.",
  "כשזה חוזר שוב ושוב,",
  "קופצת לכם התראה,",
  "שמציעה לעצור להפסקה.",
  "עוד הסברים על רובוטים?",
  "תעקבו."
 ],
 "speed": 1.15
