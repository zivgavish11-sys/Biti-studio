 "phrases": [
  "ילד קופץ לכביש.",
  "מי בולם מהר יותר,",
  "אתם,",
  "או רכב אוטונומי?",
  "ברובוטקסי של טסלה,",
  "אין לייזר ואין רדאר.",
  "רק מצלמות.",
  "אז איך מצלמה יודעת שצריך לעצור?",
  "מצלמות מכל צדי הרכב מצלמות,",
  "עשרות פעמים בשנייה.",
  "כל התמונות נכנסות למוח אחד,",
  "רשת עצבית ענקית.",
  "היא למדה מהמון סרטונים של נהיגה אמיתית,",
  "איך נראה רגע מסוכן.",
  "מהתמונות היא מעריכה מרחק,",
  "קצת כמו העיניים שלכם.",
  "וכשילד קופץ מאחורי רכב חונה...",
  "היא רואה תנועה קטנה,",
  "ומנחשת לאן הוא רץ.",
  "והנה ההבדל:",
  "אף אחד לא כתב לה חוק,",
  "אם זה ילד,",
  "תבלמי.",
  "היא למדה לבד,",
  "מהתמונה ישר להחלטה.",
  "המחשב שולח אות חשמלי,",
  "ומנוע קטן לוחץ על נוזל הבלמים...",
  "בלי רגל.",
  "ולנהג אנושי לוקח בערך שנייה,",
  "רק להבין ולהזיז את הרגל.",
  "עוד הסברים על רובוטים?",
  "תעקבו."
 ],
