 "end": 34.59,
 "phrases": [
  "יהיה אפשר לפרוץ לרובוט שלכם?",
  "חוקרים כבר עשו את זה...",
  "בלי לגעת בו.",
  "איך?",
  "כשמחברים רובוט כזה לוויפיי,",
  "הטלפון שולח לו את הסיסמה בבלוטוס.",
  "ההודעה נעולה במפתח סודי,",
  "כדי שרק האפליקציה שלכם תוכל לדבר איתו.",
  "אבל הנה החלק המטורף:",
  "לכל הרובוטים מהדגם הזה,",
  "היה אותו מפתח!",
  "החוקרים מצאו אותו,",
  "ושלחו לרובוט הודעה משלהם.",
  "במקום שם של רשת,",
  "הם החביאו בה פקודה.",
  "והרובוט,",
  "ממושמע כמו תמיד,",
  "ביצע אותה.",
  "ככה הם יכלו לקבל שליטה מלאה ברובוט.",
  "אז איך שומרים על הרובוט שלכם מפריצה?",
  "בפרק הבא.",
  "תעקבו."
 ],
