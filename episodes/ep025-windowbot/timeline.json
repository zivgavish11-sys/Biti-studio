 "end": 41.48,
 "phrases": [
  "אין לו דבק,",
  "אין לו ידיים...",
  "והוא תלוי על חלון בקומה עשר.",
  "אז מה מחזיק אותו?",
  "בתוך הרובוט יש מאוורר חזק,",
  "ששואב את האוויר מתחתיו החוצה.",
  "גומי רך מסביב,",
  "אוטם אותו לזכוכית.",
  "אבל הנה החלק המטורף:",
  "הרובוט בכלל לא נדבק.",
  "האוויר שבחוץ,",
  "דוחף אותו אל החלון!",
  "זה נקרא הפרש לחץ.",
  "מתחתיו יש קצת פחות אוויר מבחוץ,",
  "וההפרש הקטן הזה,",
  "על כל הגוף שלו,",
  "מספיק כדי להצמיד אותו חזק לזכוכית.",
  "חיישן לחץ בודק את זה כל הזמן,",
  "ואם יש דליפה,",
  "הרובוט עוצר.",
  "ואם נגמר החשמל?",
  "סוללת גיבוי ממשיכה להפעיל את המאוורר.",
  "ויש גם כבל ביטחון,",
  "שקשור מבפנים.",
  "עוד הסברים על רובוטים?",
  "תעקבו."
 ],
 "speed": 1.15
}