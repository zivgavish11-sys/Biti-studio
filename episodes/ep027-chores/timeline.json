 "end": 52.82,
 "phrases": [
  "רובוט כבר שוטף לכם רצפה,",
  "חלונות ובריכה...",
  "אבל לקפל חולצה?",
  "אז מה רובוט באמת יודע לעשות בבית,",
  "היום?",
  "יש שואבים שכבר לא רק שואבים.",
  "הם שוטפים,",
  "מרוקנים את עצמם,",
  "ואפילו מנקים את המגב של עצמם.",
  "רובוט החלונות נצמד לזכוכית,",
  "גם בקומה עשר.",
  "רובוט הבריכה מטפס על הקירות.",
  "ורובוט הדשא מכסח לבד,",
  "וחוזר לבד לטעינה.",
  "ומה עוד לא באמת?",
  "לקפל כביסה.",
  "להכניס כלים למדיח.",
  "לבשל ארוחה.",
  "רובוטים דמויי אדם כבר מנסים,",
  "אבל עוד לא לבד.",
  "אבל הנה החלק המטורף:",
  "כבר יש שואב עם זרוע,",
  "שמרים גרביים מהרצפה!",
  "עוד הסברים כאלה?",
  "תעקבו.",
  "השואב הזה איטי,",
  "ולא תמיד מצליח.",
  "אבל הגבול כבר זז.",
  "איזו מטלה הייתם הכי רוצים לתת לרובוט?",
  "תכתבו בתגובות,",
  "ובפרק הבא נסביר למה היא עוד כל כך קשה לו."
 ],
