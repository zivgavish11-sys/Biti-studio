 "end": 26.57,
 "phrases": [
  "בכל יד שלכם יש בערך שבעה עשר אלף חיישני מגע!",
  "אז למה קשה כל כך לתת לרובוט להרגיש?",
  "כי החיישנים שלכם לא רק מרגישים לחץ.",
  "חלק מהם מרגישים רטט קטן,",
  "כשחפץ מתחיל להחליק.",
  "והמוח מהדק את האחיזה,",
  "עוד לפני ששמתם לב.",
  "להרבה רובוטים יש רק כמה חיישנים ביד.",
  "אז הם מוחצים את הביצה,",
  "או מפילים אותה.",
  "אז מדענים בונים להם עור:",
  "ג'ל אחד,",
  "שכולו חיישן!",
  "תעקבו אחריי,",
  "לעוד תוכן וחדשות על רובוטים."
 ],
