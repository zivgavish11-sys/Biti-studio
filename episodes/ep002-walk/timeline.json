 "end": 40.65,
 "phrases": [
  "הרובוט הזה נפל אלפי פעמים,",
  "לפני שהוא עשה צעד אחד.",
  "אני ביטי,",
  "והיום אני אלמד אתכם איך רובוט לומד ללכת לבד.",
  "אף אחד לא מתכנת לו איך לזוז.",
  "שמים אותו בעולם וירטואלי,",
  "עם נקודות.",
  "צעד קדימה,",
  "נקודה.",
  "נפילה,",
  "מינוס.",
  "בהתחלה הוא כמו תינוק על קרח.",
  "אבל הנה החלק המטורף:",
  "הוא לא מתאמן לבד.",
  "אלפי עותקים שלו מתאמנים יחד,",
  "על מחשב אחד.",
  "תוך פחות מ־4 דקות,",
  "הוא כבר הולך על משטח ישר.",
  "ואז מעבירים את המוח שלו לרובוט אמיתי,",
  "והוא הולך.",
  "אף אחד לא לימד אותו.",
  "הנפילות לימדו.",
  "תעקבו אחריי לעוד תוכן וחדשות על רובוטים."
 ],
