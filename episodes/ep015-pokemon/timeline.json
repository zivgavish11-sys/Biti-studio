 "end": 42.74,
 "phrases": [
  "שיחקתם פוקימון גו?",
  "אימנתם אלפי רובוטים בלי לדעת!",
  "איך זה קשור?",
  "רובוט משלוחים חייב לדעת בדיוק איפה הוא.",
  "אבל בין בניינים,",
  "הניווט מהלוויין יכול לטעות בכמה מטרים.",
  "אז הרובוט צריך לזהות את המקום בעיניים,",
  "כמו בן אדם.",
  "ובשביל זה,",
  "הוא צריך תמונות של כל פינה.",
  "מכל זווית,",
  "בשעות שונות ובמזג אוויר שונה.",
  "מי יצלם את כל זה...",
  "והנה הטוויסט:",
  "אתם.",
  "המשחק שלח שחקנים לפסלים ולאתרים מוכרים,",
  "ונתן פרסים למי שסורק אותם בטלפון.",
  "יחד עם עוד משחק של החברה,",
  "הצטברו כשלושים מיליארד תמונות.",
  "מהן נבנתה מפה.",
  "המצלמה של הרובוט משווה אליה,",
  "ומוצאת איפה הוא.",
  "לפי החברה,",
  "בדיוק של סנטימטרים.",
  "עוד הסברים על רובוטים?",
  "תעקבו."
 ],
 "speed": 1.15
}