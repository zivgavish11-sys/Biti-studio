 "end": 30.07,
 "phrases": [
  "בניתי מעבדת רובוטים,",
  "וכל מי שמגיב \"קהילה\",",
  "מקבל בה עמדת טעינה עם השם שלו!",
  "אני ביטי,",
  "וזו המעבדה שלי כרגע.",
  "יש פה שולחן עבודה,",
  "זרוע רובוטית,",
  "ומדפסת תלת מימד.",
  "כן,",
  "קצת ריק פה...",
  "בינתיים.",
  "ופה,",
  "הקיר של עמדות הטעינה.",
  "כרגע יש בו רק עמדה אחת...",
  "שלי.",
  "כל השאר מחכות לכם.",
  "וכל עשרים וחמישה עוקבים חדשים,",
  "נכנס למעבדה רובוט חדש.",
  "אז תגיבו \"קהילה\",",
  "ותכתבו איזה רובוט להכניס ראשון!",
  "את השם שלכם תמצאו בחלק שתיים."
 ],
