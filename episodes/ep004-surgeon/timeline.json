 "end": 33.26,
 "phrases": [
  "בניתוח רובוטי,",
  "הרופא בכלל לא עומד ליד המטופל!",
  "אני ביטי,",
  "והיום אני אלמד אתכם,",
  "איך רובוט מנתח.",
  "המנתח יושב בצד החדר,",
  "ומסתכל לתוך מסך תלת־ממד.",
  "הוא מזיז שתי ידיות,",
  "והרובוט מעתיק כל תנועה.",
  "הכלים נכנסים לגוף דרך חתכים זעירים,",
  "בלי לפתוח את הבטן.",
  "אבל הנה החלק המטורף:",
  "הרובוט מסנן את הרעד הטבעי של הידיים.",
  "והוא מקטין כל תנועה,",
  "כך שתנועה גדולה של היד,",
  "הופכת לתנועה זעירה בפנים.",
  "אז הרובוט לא מנתח לבד...",
  "הוא נותן לרופא,",
  "ידיים שלא רועדות.",
  "תעקבו אחריי,",
  "לעוד תוכן וחדשות על רובוטים."
 ],
