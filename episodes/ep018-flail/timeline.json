 "end": 37.04,
 "phrases": [
  "הרובוט הזה תקף את המפעילים שלו?!",
  "ככה זה נראה.",
  "אבל האמת שונה לגמרי.",
  "רובוט אנושי לא עומד סתם.",
  "הוא כל הזמן מאזן את עצמו.",
  "המחשב מרגיש לאן הגוף נוטה,",
  "ומזיז ידיים ורגליים כדי לא ליפול.",
  "עכשיו תדמיינו:",
  "הרובוט תלוי באוויר,",
  "והרגליים שלו לא נוגעות ברצפה.",
  "המחשב רגיל להרגיש רצפה מתחת לרגליים...",
  "והיא לא שם.",
  "אז הוא מתקן.",
  "ועוד תיקון.",
  "וכל תיקון מנדנד את הגוף עוד יותר.",
  "לפי מי שהפעיל אותו,",
  "הסיבה היא שהפעילו את מערכת השליטה של כל הגוף,",
  "כשהרגליים לא נגעו ברצפה.",
  "זה לא כעס.",
  "זו לולאה.",
  "עוד הסברים על רובוטים?",
  "תעקבו."
 ],
 "speed": 1.15
