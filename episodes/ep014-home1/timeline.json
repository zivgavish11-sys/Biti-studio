 "end": 33.54,
 "phrases": [
  "בואו תראו איך הבית שלכם ייראה בעוד שלושים שנה!",
  "הבית הזה גדל רק בזכותכם:",
  "כל עשרה עוקבים,",
  "בטיקטוק,",
  "באינסטגרם או בפייסבוק,",
  "נכנס אליו רובוט חדש.",
  "אתם כבר יותר משלושים,",
  "אז יש פה כבר שלושה:",
  "שואב רובוטי,",
  "ששואב את כל הסלון.",
  "רובוט דמוי אדם ששוטף כלים...",
  "ולא מתלונן אף פעם.",
  "וכלב רובוטי,",
  "ששומר על החצר.",
  "לכל רובוט יש עמדת טעינה,",
  "ועליה מקום לשמות של עשרה עוקבים.",
  "רוצים את השם שלכם על אחת מהן?",
  "תעקבו,",
  "ותגיבו \"בית\".",
  "ובאותה תגובה,",
  "תבחרו מי יהיה הרובוט הרביעי:",
  "מכונית אוטונומית בחניה,",
  "או רחפן שמביא הביתה קניות מהסופר?"
 ],
