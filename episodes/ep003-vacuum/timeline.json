 "end": 38.75,
 "phrases": [
  "יש דבר אחד שהשואב הרובוטי עושה,",
  "ואף אחד לא שם לב.",
  "אני ביטי,",
  "והיום אני אלמד אתכם איך שואב מוצא את הדרך בבית.",
  "על הגג שלו יש לייזר קטן,",
  "שמסתובב בערך חמש פעמים בשנייה.",
  "הקרן פוגעת בקיר וחוזרת,",
  "וככה הוא יודע כמה הקיר רחוק.",
  "אלפי נקודות,",
  "והקירות מופיעים.",
  "אבל הנה החלק המטורף:",
  "כדי לבנות מפה,",
  "הוא צריך לדעת איפה הוא.",
  "וכדי לדעת איפה הוא,",
  "הוא צריך מפה.",
  "אז הוא עושה את שניהם בבת אחת.",
  "כשאתם חושבים שהוא סתם מסתובב,",
  "הוא בעצם ממפה.",
  "ובסוף הניקוי הראשון,",
  "יש לו מפה של כל הבית.",
  "תעקבו אחריי לעוד תוכן וחדשות על רובוטים."
 ],
 "speed": 1.25
