 "end": 36.75,
 "phrases": [
  "שלושה צעדים,",
  "והרובוט שלכם הרבה יותר קשה לפריצה.",
  "זוכרים את הפריצה מהפרק הקודם?",
  "היא עברה דרך הבלוטוס.",
  "אז צעד ראשון,",
  "אחרי שחיברתם את הרובוט,",
  "כבו לו את הבלוטוס,",
  "אם אפשר.",
  "צעד שני,",
  "עדכונים.",
  "כשחברה מגלה פרצה,",
  "היא שולחת תיקון.",
  "אבל הוא עובד רק אם התקנתם אותו.",
  "צעד שלישי,",
  "והכי חשוב:",
  "תנו לרובוט רשת ויפיי משלו.",
  "ברוב הראוטרים אפשר לפתוח רשת אורחים,",
  "בכמה לחיצות.",
  "ואז גם אם מישהו פורץ לרובוט...",
  "הוא תקוע ברשת שלו.",
  "בלי הטלפון שלכם,",
  "ובלי המחשב.",
  "קצת כמו לשים אורח בסלון,",
  "ולנעול את שאר הבית.",
  "עוד הסברים על רובוטים?",
  "תעקבו."
 ],
 "speed": 1.15
}