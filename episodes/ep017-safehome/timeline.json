 "end": 37.01,
 "phrases": [
  "מפחדים שהרובוט העתידי בבית שלכם יפגע בילדים?",
  "רובוט יכול להרגיש כשנוגעים בו...",
  "ולעצור.",
  "איך?",
  "חלק גדול מהתשובה נמצא במנועים.",
  "כל מפרק ברובוט מסתובב בעזרת מנוע חשמלי.",
  "והמחשב יודע כמה כוח המנוע אמור להשקיע,",
  "בכל תנועה.",
  "עכשיו תדמיינו:",
  "הזרוע זזה,",
  "ופוגשת יד של ילד.",
  "פתאום המנוע צריך יותר כוח.",
  "המחשב מרגיש את הקפיצה הזאת,",
  "ועוצר את הזרוע.",
  "בשבריר שנייה!",
  "והנה עוד סוד:",
  "רובוטים שמיועדים לבית בנויים קלים,",
  "עם כוח מוגבל בכוונה,",
  "וציפוי רך.",
  "כדי שאם משהו משתבש,",
  "הכוח יהיה קטן.",
  "עוד הסברים על רובוטים?",
  "תעקבו."
 ],
 "speed": 1.15
