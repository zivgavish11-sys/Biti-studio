 "end": 41.27,
 "phrases": [
  "שואב רובוטי צילם אישה בשירותים...",
  "והתמונה הגיעה לקבוצה סגורה בפייסבוק.",
  "איך זה קרה?",
  "לחלק מהשואבים החכמים יש מצלמה מקדימה,",
  "כדי לזהות גרביים וכבלים על הרצפה.",
  "אבל מישהו צריך ללמד אותו מה זה גרב.",
  "ב-2020,",
  "בשואבי ניסוי,",
  "התמונות נשלחו לחברה...",
  "ומשם לעובדים שסימנו כל תמונה:",
  "זה כבל,",
  "זה גרב,",
  "זה בן אדם.",
  "והנה הטוויסט:",
  "מי שהדליף את התמונות,",
  "לא היה האקר.",
  "אלה היו העובדים שסימנו אותן.",
  "החברה אמרה שהמשתתפים חתמו על הסכמה.",
  "חלק מהם אמרו,",
  "שלא הבינו שזה כולל דברים כאלה.",
  "אז לפני שקונים,",
  "תבדקו:",
  "יש שואבים שרואים רק עם לייזר,",
  "בלי מצלמה בכלל.",
  "עוד הסברים על רובוטים?",
  "תעקבו."
 ],
 "speed": 1.15
}